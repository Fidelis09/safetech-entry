# ============================================================
# DADOS PESSOAIS - nunca vão para o repositório
# ============================================================

# Fotos de treino (imagens de pessoas). A estrutura de pastas é
# mantida pelos arquivos .gitkeep, mas as imagens ficam só no computador.
dataset/*/*
!dataset/*/.gitkeep

# Planilha de rótulos das fotos de treino (só faz sentido junto delas)
dataset/rotulos*.csv

# Log de auditoria e fotos de evidência (gerados pelo programa)
auditoria/

# Última seleção de setor feita na tela (preferência de cada computador)
preferencias.json

# ============================================================
# ARQUIVOS LOCAIS
# ============================================================

# Cópia de segurança da versão antiga do código
_versao_anterior/

# Configurações locais de ferramentas
.claude/
.vscode/
.idea/

# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
.venv/
venv/
env/

# ============================================================
# SISTEMA OPERACIONAL
# ============================================================

Thumbs.db
desktop.ini
.DS_Store
